<UserControl x:Class="RouteJumper.Views.RouteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:RouteJumper.Converters"
             xmlns:behaviors="clr-namespace:RouteJumper.Behaviors"
             xmlns:common="clr-namespace:RouteJumper.Common"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="700">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:IconStatusToPackIconKindConverter x:Key="IconStatusToPackIconKindConverter" />
        <converters:RowIconToVisibilityConverter x:Key="RowIconToVisibilityConverter" />
        <converters:AutoPilotLabelConverter x:Key="AutoPilotLabelConverter" />
        <converters:BoolToHiddenVisibilityConverter x:Key="BoolToHiddenVisibilityConverter" />

        <!-- Gives the Jumps/Refuel/Inject/Neutron DataGridColumns below a stable path back to
             this page's own DataContext (RouteViewModel) - see BindingProxy's own doc comment for
             why a DataGridColumn can't reach it any more directly. -->
        <common:BindingProxy x:Key="ViewModelProxy" Data="{Binding}" />

        <!-- Same appearance/selection behavior as the toolkit's own cell style - just without
             the "current cell" border a click leaves behind. That border comes from the base
             style's own IsFocused/IsSelected triggers setting BorderThickness/BorderBrush on the
             cell's template (not the FocusVisualStyle adorner, which has no effect here), so it's
             neutralized with triggers of our own for the same conditions, appended after the
             inherited ones and so taking precedence. The grey row selection background is a
             separate, row-level trigger (see RowStyle below) and is untouched by this. -->
        <Style x:Key="RouteDataGridCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderThickness" Value="0" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="BorderThickness" Value="0" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderThickness" Value="0" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Margin="12">

        <!-- ===================== Text entry (visible before Save) ===================== -->
        <Grid Visibility="{Binding IsSaved, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox x:Name="RouteTextBox"
                     Grid.Row="0"
                     Text="{Binding RouteText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="14"
                     VerticalContentAlignment="Top"
                     materialDesign:HintAssist.Hint="Paste route here, one system per line."
                     materialDesign:HintAssist.IsFloating="False" />

            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Button Content="Reverse"
                        Command="{Binding ReverseCommand}"
                        HorizontalAlignment="Left"
                        Width="90"
                        Padding="4" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Save"
                            Command="{Binding SaveCommand}"
                            Width="90"
                            Padding="4"
                            Margin="0,0,8,0" />
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Width="90"
                            Padding="4" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ===================== Table + Auto Pilot (visible after Save) ===================== -->
        <Grid Visibility="{Binding IsSaved, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Dismissible advisory (SPEC §4.9) shown once a completed Distance/Star Type
                 enrichment pass confirms at least one row is stuck showing "Plot needed"/"Target
                 needed" - not an error (Secondary palette, not the red ValidationError brush
                 MainWindow's own playback-failure banner uses, §6.5), just a nudge pointing at
                 the per-row placeholders themselves, which stay showing regardless of whether
                 this is dismissed. Re-evaluated (and un-dismissed) fresh on every Save. -->
            <Border Grid.Row="0"
                    Visibility="{Binding ShowUnresolvedSystemsBanner, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{DynamicResource MaterialDesign.Brush.Secondary}"
                    Padding="10,6"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Grid.Column="0"
                                              Kind="InformationOutline"
                                              Foreground="{DynamicResource MaterialDesign.Brush.Secondary.Foreground}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1"
                               Text="Some systems couldn't be resolved from EDSM. Follow each row's own &quot;Plot needed&quot;/&quot;Target needed&quot; hint to fill them in, or ignore this - it has no effect on tracking."
                               Foreground="{DynamicResource MaterialDesign.Brush.Secondary.Foreground}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="2"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Foreground="{DynamicResource MaterialDesign.Brush.Secondary.Foreground}"
                            Padding="4"
                            Command="{Binding DismissUnresolvedSystemsBannerCommand}"
                            ToolTip="Dismiss"
                            AutomationProperties.Name="Dismiss unresolved systems notice">
                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16" />
                    </Button>
                </Grid>
            </Border>

            <!-- Session-only preference - not shown while editing, not persisted across app
                 restarts. Copies the next system to the clipboard the instant a live-monitored
                 CarrierLocation event is observed for the assigned Captain's carrier, ahead of
                 the route table's own (deliberately delayed) status update. -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,0,0,8">
                <TextBlock Text="Auto Copy To Clipboard"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                              IsChecked="{Binding AutoCopyToClipboardEnabled}" />
            </StackPanel>

            <DataGrid x:Name="RouteDataGrid"
                      Grid.Row="2"
                      Style="{StaticResource MaterialDesignDataGrid}"
                      ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeaderWidth="0"
                      CellStyle="{StaticResource RouteDataGridCellStyle}">
                <DataGrid.RowStyle>
                    <!-- Clicking anywhere in a row (not just the System cell) copies that
                         row's system name - see ClickCommandBehavior. Right-click gives a
                         manual "Set next system" override (off-route recovery) - the row's own
                         DataContext is the RouteRowViewModel, but a ContextMenu
                         is not part of the visual tree, so RelativeSource AncestorType=UserControl
                         can't reach the ViewModel from inside it; Tag smuggles it through instead
                         (see the ContextMenu's own bindings via PlacementTarget below). -->
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="ToolTip" Value="Click to copy the system name to the clipboard" />
                        <Setter Property="behaviors:ClickCommandBehavior.Command"
                                Value="{Binding DataContext.CopySystemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <Setter Property="behaviors:ClickCommandBehavior.CommandParameter" Value="{Binding}" />
                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu Padding="0">
                                    <MenuItem Header="Set next system"
                                              Padding="12,3"
                                              MinHeight="0"
                                              Command="{Binding PlacementTarget.Tag.SetNextSystemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>

                    <!-- Blank icon column - a fixed default (not Auto: DataGridTemplateColumn's
                         Auto-sizing measured this narrower than the 18x18 PackIcon actually
                         needs on a fresh, never-resized launch, clipping it) - 54 is 50% wider
                         than the icon's own former 36px MinWidth floor, which stays as a
                         drag-resize floor below. -->
                    <DataGridTemplateColumn Header="" Width="54" MinWidth="36">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <materialDesign:PackIcon Visibility="{Binding Icon, Converter={StaticResource RowIconToVisibilityConverter}}"
                                                          Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                                                          Width="18"
                                                          Height="18"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Kind>
                                        <MultiBinding Converter="{StaticResource IconStatusToPackIconKindConverter}">
                                            <Binding Path="Icon" />
                                            <Binding Path="Status" />
                                        </MultiBinding>
                                    </materialDesign:PackIcon.Kind>
                                </materialDesign:PackIcon>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Unlike the System/Status columns (DataGridTemplateColumns whose own inner
                         TextBlock explicitly sets VerticalAlignment="Center"), a plain
                         DataGridTextColumn's generated TextBlock has no such override by default -
                         it stretches to the cell's full (now Status-driven, taller-than-a-line-of-
                         text) height and draws from the top, leaving "#" sitting visibly higher
                         than the other columns. ElementStyle targets that generated TextBlock
                         directly to centre it the same way. -->
                    <DataGridTextColumn Header="#"
                                         Binding="{Binding Number}"
                                         Width="40">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- A DataGridTemplateColumn, not a plain DataGridTextColumn, since the
                         clipboard icon needs to appear after the System text. A bare TextBlock +
                         PackIcon carries no implicit control style to leak into the row (unlike
                         a Button would), so alignment stays consistent with the other columns.
                         Width is a weighted star, not Auto: an Auto column never shrinks below
                         its content's natural width, so a long real system name (e.g. "Col 285
                         Sector NL-J b23-1") forced the whole grid wider than the window on
                         resize, which is what actually caused both symptoms reported - the
                         horizontal scrollbar itself, and the Status column (and so its progress
                         bar) collapsing to its bare MinWidth instead of sharing the remaining
                         space, since the DataGrid's star-width distribution only behaves
                         correctly among Star columns, not alongside an Auto sibling demanding
                         more room than is available. TextTrimming covers the one thing Auto used
                         to guarantee for free - the full name is still one hover away via
                         ToolTip. -->
                    <DataGridTemplateColumn Header="System" Width="2*" MinWidth="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- A Grid, not a StackPanel: a horizontal StackPanel always
                                     measures its children at infinite available width, so
                                     TextTrimming below would never actually have anything to
                                     trim against - only a constrained column (Width="*") forces
                                     the TextBlock down to the cell's real width. -->
                                <Grid ToolTip="{Binding SystemText}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding SystemText}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <materialDesign:PackIcon Grid.Column="1"
                                                              Kind="ClipboardCheckOutline"
                                                              Width="14"
                                                              Height="14"
                                                              Margin="6,0,0,0"
                                                              Opacity="0.7"
                                                              VerticalAlignment="Center"
                                                              Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                                                              Visibility="{Binding IsCopiedToClipboard, Converter={StaticResource BoolToVisibilityConverter}}"
                                                              ToolTip="Currently on the clipboard" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Leg distance, previous row -> this row (row 1's "previous" is wherever the
                         CMDR's own ship was when the route was last saved) - see
                         RouteRowViewModel.Distance's own doc comment. Resolved asynchronously
                         against EDSM after Save/restore; blank while still resolving, or while
                         blocked only by a neighboring row's own missing data. Once this row's own
                         coordinates are confirmed unavailable from EDSM, DistanceDisplay switches
                         to small, light "Plot needed" text instead (SPEC §4.9) - the DataTrigger
                         below supplies the smaller/muted styling for that placeholder text only,
                         leaving a real resolved distance at the column's normal text style. Same
                         ElementStyle centering fix as "#" above - a plain DataGridTextColumn's
                         generated TextBlock doesn't auto-center against Status's taller row
                         height. -->
                    <DataGridTextColumn Header="Distance"
                                         Binding="{Binding DistanceDisplay}"
                                         Width="90"
                                         MinWidth="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDistancePlaceholder}" Value="True">
                                        <Setter Property="FontSize" Value="10" />
                                        <Setter Property="Opacity" Value="0.6" />
                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Secondary}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Neutron Plotter routes only (RouteViewModel.IsNeutronRoute) - ordinary
                         hops since the previous waypoint, straight from Spansh's own response
                         (RouteRowViewModel.Jumps). Column-level Visibility binds via the
                         BindingProxy declared above (Source={StaticResource ViewModelProxy}), not
                         ElementName - confirmed live that an ElementName binding into a
                         DataGridColumn never actually evaluates (it isn't part of the visual tree,
                         so ElementName's own tree-walk resolution has nothing to walk from),
                         leaving every one of these four columns stuck at their DP default of
                         Visible regardless of RouteType. Reuses BoolToVisibilityConverter (already
                         declared above) rather than a dedicated converter. -->
                    <DataGridTextColumn Header="Jumps"
                                         Binding="{Binding Jumps}"
                                         Width="60"
                                         MinWidth="50"
                                         Visibility="{Binding Data.IsNeutronRoute, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Galaxy Plotter routes only (RouteViewModel.IsGalaxyRoute) - whether a
                         refuel/FSD injection is needed, or this waypoint is a neutron/white dwarf
                         star, straight from Spansh's own response (RouteRowViewModel.MustRefuel/
                         MustInject/HasNeutron). Same BindingProxy-based column Visibility
                         technique as Jumps above; each cell shows a small checkmark icon only when
                         true - null (this row isn't part of a Galaxy route at all) collapses the
                         same as false, via the same BoolToVisibilityConverter every bool? binds
                         through elsewhere in this app. -->
                    <DataGridTemplateColumn Header="Refuel"
                                             Width="60"
                                             MinWidth="50"
                                             Visibility="{Binding Data.IsGalaxyRoute, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <materialDesign:PackIcon Kind="Check"
                                                          Width="16"
                                                          Height="16"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                                                          Visibility="{Binding MustRefuel, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Inject"
                                             Width="60"
                                             MinWidth="50"
                                             Visibility="{Binding Data.IsGalaxyRoute, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <materialDesign:PackIcon Kind="Check"
                                                          Width="16"
                                                          Height="16"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                                                          Visibility="{Binding MustInject, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Neutron"
                                             Width="70"
                                             MinWidth="60"
                                             Visibility="{Binding Data.IsGalaxyRoute, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <materialDesign:PackIcon Kind="Check"
                                                          Width="16"
                                                          Height="16"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                                                          Visibility="{Binding HasNeutron, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- This row's system's main star's EDSM subType (e.g. "K (Yellow-Orange)
                         Star") - resolved the same way/timing as Distance above. While this row's
                         own coordinates are known but star type specifically isn't, StarTypeDisplay
                         shows small, light "Target needed" text instead (SPEC §4.9) - a single
                         FSDTarget is enough to fix that, no full route plot required, unlike
                         Distance's "Plot needed". -->
                    <DataGridTextColumn Header="Star Type"
                                         Binding="{Binding StarTypeDisplay}"
                                         Width="150"
                                         MinWidth="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStarTypePlaceholder}" Value="True">
                                        <Setter Property="FontSize" Value="10" />
                                        <Setter Property="Opacity" Value="0.6" />
                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Secondary}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- A thin ProgressBar sits below the Status text (its own Grid row, not
                         overlapping) and visually counts down however long the current status
                         (Plotted/Jumping/Cooldown) has left - full the instant that status
                         starts, draining to empty as it approaches its own known end (see
                         RouteRowViewModel.Progress), or sweeping indeterminately for "Plotting"
                         (RouteRowViewModel.IsIndeterminateProgress, §4.4). Invisible (Hidden, not
                         Collapsed - same reserved-space convention the icon column's
                         RowIconToVisibilityConverter already uses) for a status with no known end
                         (blank "waiting" or Complete), so a row without a progress bar still
                         renders at the exact same height as one with it, rather than shrinking by
                         the bar's own space.

                         Reaching the actual column width took two separate fixes, neither of
                         which was alignment:
                         (1) RouteView.xaml.cs deliberately never persists/restores this column's
                         width (unlike the other three, §4.2/§7) - it used to, which captured
                         whatever pixel width the column happened to be showing on close and
                         forced that back as a literal fixed width on every later launch,
                         permanently overriding this column's own Star sizing the first time the
                         window was ever closed, regardless of its size after that.
                         (2) The System column's width used to be Auto, which never shrinks below
                         its content's natural width - a long real system name could force the
                         whole grid wider than the window (the reported resize-triggers-a-
                         scrollbar symptom), and a DataGrid's Star distribution only behaves
                         correctly among Star columns, not alongside an Auto sibling demanding
                         more room than is available - so this column collapsed to its bare
                         MinWidth instead of taking its share of the remainder. Giving System a
                         weighted Star width instead (see above) fixed that.
                         A HorizontalContentAlignment="Stretch" setter on the cell style was an
                         earlier, ultimately irrelevant attempt - MaterialDesignDataGridCell's own
                         ControlTemplate hosts its ContentPresenter with no such binding at all, so
                         it was silently inert regardless. Binding the template's own Width/Height
                         directly to the DataGridCell's ActualWidth/ActualHeight was a separate
                         dead end - that's circular (a cell's size is normally derived FROM its
                         content, not the other way around) and broke the whole tab's layout when
                         tried. -->
                    <DataGridTemplateColumn Header="Status" Width="3*" MinWidth="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Every other column's text centres on the DataGridRow's full
                                         shared height - which this Status cell's own reserved
                                         progress-bar row already drives taller than a bare line of
                                         text needs, even while the bar itself is Hidden (§4.4's
                                         reserved-space convention). Centering this TextBlock only
                                         within Row 0's own share of that height (excluding Row 1
                                         below it) left it sitting visibly higher than System/#.
                                         Margin="0,8,0,0" (top only) pushes it back down by exactly
                                         Row 1's own reserved height (margin 4 + bar height 4 = 8) -
                                         Row 0 is Star-sized to fit its content, so this grows Row 0
                                         by that same 8px, landing the text dead centre of the total
                                         (original text height + 8px of new padding above + Row 1's
                                         existing 8px below) instead of just Row 0's now-taller share
                                         of it. A Grid.RowSpan="2" + centered alternative was tried
                                         first - simpler on paper, but Grid's Star/RowSpan resolution
                                         splits any added height roughly evenly above *and* below the
                                         text, diluting most of it away from the one gap that actually
                                         needed it (confirmed by screenshot: even an oversized 16px
                                         margin only opened a 2-3px real gap). This explicit margin
                                         is deterministic instead - the exact minimum needed to match
                                         System/#'s centering while still leaving the bar its own
                                         clear 4px gap below the text, confirmed by screenshot. -->
                                    <TextBlock Grid.Row="0"
                                               Text="{Binding StatusDisplay}"
                                               VerticalAlignment="Center"
                                               Margin="0,8,0,0" />

                                    <!-- IsIndeterminate shows WPF's own animated marquee in place of Value while
                                         Status is "Plotting" (RouteRowViewModel.IsIndeterminateProgress) - there's no
                                         way to know in advance how long playing the Captain's macro will take, so
                                         this is the cue for "actively working" rather than a countdown. -->
                                    <ProgressBar Grid.Row="1"
                                                 Minimum="0" Maximum="1"
                                                 Value="{Binding Progress, Mode=OneWay}"
                                                 IsIndeterminate="{Binding IsIndeterminateProgress}"
                                                 Visibility="{Binding ShowProgressBar, Converter={StaticResource BoolToHiddenVisibilityConverter}}"
                                                 Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Height="4"
                                                 Margin="0,4,0,0"
                                                 HorizontalAlignment="Stretch" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>

            <!-- Import Current Route + Trim for FC + Auto Pilot pinned to the far left (in their
                 own StackPanel, so each slides in right after the previous one rather than needing
                 independent positioning) and Edit to the far right of the same Grid - left-to-right
                 order follows the sequence a CMDR would actually click them in: import/trim the
                 route first, then engage Auto Pilot last. Import is always visible, in both
                 tracking modes, leftmost - it's the sole left-hand button in Ship mode, since
                 Trim/Auto Pilot (ShowTrimButton/ShowAutoPilotButton) are both Fleet-Carrier-only.
                 Both Import and Trim replace/rewrite the currently-saved route outright, so both
                 confirm via a Yes/No dialog before doing anything (see RouteView.xaml.cs) - once
                 confirmed, each applies immediately (no Edit-state detour, no follow-up dialog),
                 since there's nothing left to review once the CMDR has already said yes. -->
            <Grid Grid.Row="3" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left">
                    <Button Content="Import Current Route"
                            Click="OnImportFromNavRouteClick"
                            Padding="4"
                            Margin="0,0,8,0" />
                    <!-- Fleet Carrier mode only (ShowTrimButton) - collapses the saved route's rows
                         down to a series of hops no more than 500ly apart (RouteViewModel.
                         TrimToJumpRange), a planning aid for a route pasted/imported with many
                         closely-spaced waypoints. -->
                    <Button Content="Trim for FC"
                            Click="OnTrimToJumpRangeClick"
                            Visibility="{Binding ShowTrimButton, Converter={StaticResource BoolToVisibilityConverter}}"
                            Padding="4"
                            Margin="0,0,8,0" />
                    <Button Content="{Binding IsAutoPilotRunning, Converter={StaticResource AutoPilotLabelConverter}}"
                            Command="{Binding AutoPilotCommand}"
                            Visibility="{Binding ShowAutoPilotButton, Converter={StaticResource BoolToVisibilityConverter}}"
                            Width="90"
                            Padding="4"
                            Margin="0,0,8,0" />

                    <!-- Companion site QR code (SPEC §13) - shown only while a companion session
                         is actually live (set the instant Auto Pilot engages and a session was
                         started successfully) AND no macro is currently executing
                         (ShowCompanionButton) - hidden, not just disabled, for the duration of a
                         macro run since clicking "Open in browser" mid-script risks stealing focus
                         from the target Elite Dangerous window (§4.7's panic mode). A ToggleButton
                         driving a Popup directly, no code-behind needed for open/close - only
                         "Copy Link" below needs one, the same clipboard-copy-with-confirmation-sound
                         convention already used for row click-to-copy (§4.6) and the Roles tab's
                         journal filename click-to-copy (§5.3). -->
                    <ToggleButton x:Name="CompanionToggle"
                                  Style="{StaticResource MaterialDesignIconButton}"
                                  Visibility="{Binding ShowCompanionButton, Converter={StaticResource BoolToVisibilityConverter}}"
                                  IsChecked="{Binding IsCompanionPopupOpen, Mode=TwoWay}"
                                  ToolTip="Show companion site QR code">
                        <materialDesign:PackIcon Kind="Qrcode" />
                    </ToggleButton>
                    <Popup PlacementTarget="{Binding ElementName=CompanionToggle}"
                           Placement="Bottom"
                           StaysOpen="False"
                           IsOpen="{Binding IsCompanionPopupOpen, Mode=TwoWay}">
                        <materialDesign:Card Padding="16" UniformCornerRadius="8">
                            <StackPanel Width="220" HorizontalAlignment="Center">
                                <TextBlock Text="Scan to follow along on your phone"
                                           FontWeight="Medium"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="0,0,0,8" />
                                <!-- Clicking the QR code itself opens the link directly in the
                                     default browser - a quicker way to open the page locally
                                     than scanning it, e.g. while testing against a local
                                     `ng serve` instance (CompanionSiteBaseUrl, §13). A bare,
                                     template-stripped Button - not MaterialDesignFlatButton -
                                     since MaterialDesignThemes' own implicit (un-styled) Button
                                     default already sets a fixed Height/MinHeight/MinWidth via
                                     its base style - a ContentPresenter-only template alone still
                                     inherits those Setters (only Template itself was overridden),
                                     clamping the image's rendered height and clipping most of the
                                     QR code away. Height/MinHeight/MinWidth are set as local values
                                     here specifically to win over that inherited style. -->
                                <Button Command="{Binding OpenCompanionSiteCommand}"
                                        Padding="0"
                                        Margin="0"
                                        Height="Auto"
                                        MinHeight="0"
                                        MinWidth="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        ToolTip="Open in browser"
                                        HorizontalAlignment="Center">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Image Source="{Binding CompanionQrImage}"
                                           Width="180"
                                           Height="180" />
                                </Button>
                                <Button Content="Copy Link"
                                        Click="OnCopyCompanionLinkClick"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </materialDesign:Card>
                    </Popup>
                </StackPanel>
                <!-- IsEnabled (not Command) - see RouteView.xaml.cs.OnEditClick's own doc
                     comment for why a maybe-cancel confirmation dialog can't live behind a bound
                     Command (WPF's ButtonBase.OnClick always executes Command right after raising
                     Click, regardless of anything the Click handler does). EditCommand itself is
                     unchanged and still called directly, from code-behind, once confirmed. -->
                <Button Content="Edit"
                        IsEnabled="{Binding CanEdit}"
                        Click="OnEditClick"
                        HorizontalAlignment="Right"
                        Width="90"
                        Padding="4" />
            </Grid>
        </Grid>

    </Grid>
</UserControl>
