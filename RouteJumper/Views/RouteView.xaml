<UserControl x:Class="RouteJumper.Views.RouteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:RouteJumper.Converters"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="700">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:IconToGlyphConverter x:Key="IconToGlyphConverter" />
    </UserControl.Resources>

    <Grid Margin="12">

        <!-- ===================== Text entry (visible before Save) ===================== -->
        <Grid Visibility="{Binding IsSaved, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox Grid.Row="0"
                     Text="{Binding RouteText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="14" />

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0">
                <Button Content="Save"
                        Command="{Binding SaveCommand}"
                        Width="90"
                        Padding="4"
                        Margin="0,0,8,0" />
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Width="90"
                        Padding="4" />
            </StackPanel>
        </Grid>

        <!-- ===================== Table + Start/Stop (visible after Save) ===================== -->
        <Grid Visibility="{Binding IsSaved, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0"
                      ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeaderWidth="0">
                <DataGrid.Columns>

                    <!-- Blank icon column -->
                    <DataGridTemplateColumn Header="" Width="36">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Icon, Converter={StaticResource IconToGlyphConverter}}"
                                           Foreground="Green"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="#"
                                         Binding="{Binding Number}"
                                         Width="40" />

                    <DataGridTextColumn Header="System"
                                         Binding="{Binding SystemText}"
                                         Width="*" />

                    <DataGridTextColumn Header="Status"
                                         Binding="{Binding Status}"
                                         Width="140" />

                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0">
                <Button Content="Start"
                        Command="{Binding StartCommand}"
                        Width="90"
                        Padding="4"
                        Margin="0,0,8,0" />
                <Button Content="Stop"
                        Command="{Binding StopCommand}"
                        Width="90"
                        Padding="4" />
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
