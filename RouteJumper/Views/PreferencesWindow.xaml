<Window x:Class="RouteJumper.Views.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Style="{StaticResource MaterialDesignWindow}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        Title="Preferences"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        d:DesignHeight="260" d:DesignWidth="420">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Spoken announcements (Auto Pilot's plot/refuel countdowns) - voice, volume, and a
             way to preview both without needing Auto Pilot running. Every change here is saved
             immediately, the same as the Controls tab's own Options section - Close below is
             purely a "done for now" navigation action, not a distinct save step. -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Voice" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1"
                      Margin="0,0,4,0"
                      ItemsSource="{Binding AvailableVoices}"
                      SelectedItem="{Binding VoiceName}"
                      materialDesign:HintAssist.Hint="Blank = system default"
                      AutomationProperties.Name="Announcement voice" />
            <Button Grid.Column="2"
                    Style="{StaticResource MaterialDesignIconButton}"
                    Padding="4"
                    Command="{Binding ClearVoiceCommand}"
                    ToolTip="Reset to system default voice"
                    AutomationProperties.Name="Clear voice">
                <materialDesign:PackIcon Kind="Close" Width="16" Height="16" />
            </Button>
            <Button Grid.Column="3"
                    Style="{StaticResource MaterialDesignIconButton}"
                    Padding="4"
                    Command="{Binding TestCommand}"
                    ToolTip="Test the selected voice/volume"
                    AutomationProperties.Name="Test voice">
                <materialDesign:PackIcon Kind="PlayCircleOutline" Width="20" Height="20" />
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Volume" VerticalAlignment="Center" />
            <Slider Grid.Column="1"
                    VerticalAlignment="Center"
                    Minimum="0" Maximum="100"
                    Value="{Binding Volume}"
                    AutomationProperties.Name="Announcement volume" />
            <TextBlock Grid.Column="2"
                       Text="{Binding Volume, StringFormat={}{0}%}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right" />
        </Grid>

        <!-- Whether App.xaml.cs's silent startup update check (§3.7) runs at all - File/Help >
             Check for Updates itself always runs regardless, since that's an explicit request,
             not the background check this controls. Bound via RelativeSource, not DataContext
             (which stays SpeechAnnouncer for every control above), since this is a different
             ViewModel (PreferencesWindow.UpdatePreferences) - see this window's own code-behind. -->
        <CheckBox Grid.Row="2"
                  Margin="0,0,0,16"
                  Content="Automatically check for updates on startup"
                  IsChecked="{Binding UpdatePreferences.AutoCheckEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                  AutomationProperties.Name="Automatically check for updates on startup" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Close"
                    Width="90"
                    Padding="4"
                    IsCancel="True"
                    Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
