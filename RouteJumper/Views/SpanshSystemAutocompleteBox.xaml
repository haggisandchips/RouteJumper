<UserControl x:Class="RouteJumper.Views.SpanshSystemAutocompleteBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             x:Name="Root"
             PreviewLostKeyboardFocus="OnControlPreviewLostKeyboardFocus"
             d:DesignHeight="30" d:DesignWidth="300">

    <!-- A plain TextBox (never an editable ComboBox) + a manually-managed Popup/ListBox: typing
         and keyboard/mouse browsing of Picker.Suggestions are kept entirely separate from
         Picker.Selected, which only ever changes via an explicit commit (Enter or a click) -
         see this control's own code-behind for why a stock editable ComboBox (WPF ties
         SelectedItem to *every* arrow-key press, and auto-selects+highlights an exact text match)
         made both typing and arrow-key browsing fight the CMDR's own input. -->
    <Grid>
        <TextBox x:Name="QueryTextBox"
                 Text="{Binding Picker.Query, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                 materialDesign:HintAssist.Hint="{Binding Hint, ElementName=Root}"
                 PreviewKeyDown="OnQueryTextBoxPreviewKeyDown" />

        <!-- StaysOpen="True": with the more usual StaysOpen="False", the Popup auto-closes the
             instant keyboard focus moves into SuggestionsListBox (Down arrow, below), before a
             single item could ever be browsed. Closing is instead handled explicitly - Escape,
             a commit, or focus leaving this control entirely (OnControlPreviewLostKeyboardFocus). -->
        <Popup x:Name="SuggestionsPopup"
               PlacementTarget="{Binding ElementName=QueryTextBox}"
               Placement="Bottom"
               Width="{Binding ActualWidth, ElementName=QueryTextBox}"
               IsOpen="{Binding Picker.IsDropDownOpen, ElementName=Root}"
               StaysOpen="True"
               AllowsTransparency="True">
            <Border Background="{DynamicResource MaterialDesignPaper}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="1">
                <ListBox x:Name="SuggestionsListBox"
                         ItemsSource="{Binding Picker.Suggestions, ElementName=Root}"
                         DisplayMemberPath="Name"
                         MaxHeight="220"
                         PreviewMouseLeftButtonUp="OnSuggestionMouseUp"
                         PreviewKeyDown="OnSuggestionsListBoxPreviewKeyDown" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
