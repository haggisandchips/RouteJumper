<UserControl x:Class="RouteJumper.Views.RolesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:RouteJumper.ViewModels"
             xmlns:converters="clr-namespace:RouteJumper.Converters"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="700">

    <UserControl.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="{Binding StatusText}"
                       Visibility="{Binding StatusText, Converter={StaticResource StringToVisibilityConverter}}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Opacity="0.6"
                       FontStyle="Italic" />

            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Instances}" HorizontalContentAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:EliteInstanceViewModel}">
                            <materialDesign:Card Margin="0,0,0,12" Padding="16">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding CommanderName}"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ProcessId, StringFormat='PID {0}'}"
                                                       Opacity="0.6"
                                                       Margin="0,0,0,8" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Content="Captain"
                                                    Margin="0,0,6,0"
                                                    Padding="10,4"
                                                    FontSize="11"
                                                    Command="{Binding DataContext.ToggleCaptainCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Assign/unassign the Captain role">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCaptain}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Secondary}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Secondary.Foreground}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="Engineer"
                                                    Padding="10,4"
                                                    FontSize="11"
                                                    Command="{Binding DataContext.ToggleEngineerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Assign/unassign the Engineer role (requires available cargo space)">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEngineer}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Secondary}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Secondary.Foreground}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <materialDesign:PackIcon Grid.Row="0" Grid.Column="0"
                                                                  Kind="CardAccountDetailsOutline"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,8,0" />
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                    Text="{Binding Fid}"
                                                    VerticalAlignment="Center"
                                                    TextTrimming="CharacterEllipsis" />

                                        <!-- CargoDisplay's "x" includes tritium; the tritium
                                             sub-line (icon + text) sits directly under it in the
                                             same column, so its icon lines up with where "x"
                                             starts rather than with PackageVariantClosed above -
                                             omitted entirely (TritiumDisplay empty) when there's
                                             none. -->
                                        <materialDesign:PackIcon Grid.Row="1" Grid.Column="0"
                                                                  Kind="PackageVariantClosed"
                                                                  VerticalAlignment="Top"
                                                                  Margin="0,6,8,0" />
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding CargoDisplay}"
                                                        TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal"
                                                        Margin="0,2,0,0"
                                                        Visibility="{Binding TritiumDisplay, Converter={StaticResource StringToVisibilityConverter}}">
                                                <materialDesign:PackIcon Kind="GasStationOutline"
                                                                          Width="14"
                                                                          Height="14"
                                                                          Opacity="0.65"
                                                                          VerticalAlignment="Center"
                                                                          Margin="0,0,4,0" />
                                                <TextBlock Text="{Binding TritiumDisplay}"
                                                            Opacity="0.65"
                                                            FontSize="11"
                                                            VerticalAlignment="Center"
                                                            TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>

                                        <materialDesign:PackIcon Grid.Row="2" Grid.Column="0"
                                                                  Kind="MapMarkerOutline"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,6,8,0" />
                                        <TextBlock Grid.Row="2" Grid.Column="1"
                                                    Text="{Binding LocationDisplay}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,6,0,0"
                                                    TextTrimming="CharacterEllipsis" />

                                        <materialDesign:PackIcon Grid.Row="3" Grid.Column="0"
                                                                  Kind="SpaceStation"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,6,8,0" />
                                        <TextBlock Grid.Row="3" Grid.Column="1"
                                                    Text="{Binding CarrierDisplay}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,6,0,0"
                                                    TextTrimming="CharacterEllipsis" />

                                        <materialDesign:PackIcon Grid.Row="4" Grid.Column="0"
                                                                  Kind="FileDocumentOutline"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,6,8,0" />
                                        <TextBlock Grid.Row="4" Grid.Column="1"
                                                    Text="{Binding JournalFileName}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,6,0,0"
                                                    TextTrimming="CharacterEllipsis" />

                                        <materialDesign:PackIcon Grid.Row="5" Grid.Column="0"
                                                                  Kind="ApplicationOutline"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,6,8,0" />
                                        <TextBlock Grid.Row="5" Grid.Column="1"
                                                    Text="{Binding WindowHandleDisplay}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,6,0,0"
                                                    TextTrimming="CharacterEllipsis" />

                                        <materialDesign:PackIcon Grid.Row="6" Grid.Column="0"
                                                                  Kind="CrosshairsGps"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,6,8,0" />
                                        <TextBlock Grid.Row="6" Grid.Column="1"
                                                    Text="{Binding WindowPosition}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,6,0,0"
                                                    TextTrimming="CharacterEllipsis" />

                                        <materialDesign:PackIcon Grid.Row="7" Grid.Column="0"
                                                                  Kind="Monitor"
                                                                  VerticalAlignment="Top"
                                                                  Margin="0,6,8,0" />
                                        <TextBlock Grid.Row="7" Grid.Column="1"
                                                    Text="{Binding MonitorInfo}"
                                                    Margin="0,6,0,0"
                                                    TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Command="{Binding RefreshCommand}" Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Refresh" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
