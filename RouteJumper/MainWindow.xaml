<Window x:Class="RouteJumper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:views="clr-namespace:RouteJumper.Views"
        xmlns:vm="clr-namespace:RouteJumper.ViewModels"
        xmlns:converters="clr-namespace:RouteJumper.Converters"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Style="{StaticResource MaterialDesignWindow}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        Title="ED:FC Auto Pilot" Height="600" Width="800"
        Icon="Resources/AppIcon.ico">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <converters:MuteIconConverter x:Key="MuteIconConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- File menu + mute button, both always visible regardless of which tab is active.
             Shaded and underlined so it reads as its own toolbar strip rather than blending into
             the tab area below it. -->
        <Border Grid.Row="0"
                Background="#14000000"
                BorderBrush="#33000000"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Menu Grid.Column="0" Background="Transparent">
                    <MenuItem Header="_File">
                        <MenuItem Header="_Preferences…" Click="OnPreferencesClick" />
                        <Separator />
                        <MenuItem Header="E_xit" Click="OnExitClick" />
                    </MenuItem>
                    <MenuItem Header="_Integrations">
                        <MenuItem Header="_Spansh…" Click="OnSpanshClick" />
                    </MenuItem>
                    <MenuItem Header="_Help">
                        <MenuItem Header="_Logs" Click="OnLogsClick" />
                        <MenuItem Header="Check for _Updates" Click="OnCheckForUpdatesClick" />
                        <MenuItem Header="_About" Click="OnAboutClick" />
                    </MenuItem>
                </Menu>

                <!-- Switches between Fleet Carrier mode (Roles/Controls tabs, Auto Pilot) and
                     Ship mode (Track tab, no automation) - see MainViewModel.ApplyMode. A pair of
                     mutually-exclusive choice chips (same RadioButton GroupName), Fleet Carrier
                     first since it's the default mode, centred in the toolbar strip (this middle
                     column stretches; File/mute stay Auto-sized either side of it), always visible
                     regardless of which tab is active. No "Mode" label - which chip is selected
                     already makes that obvious. Each chip's own ToolTip explains what switching to
                     it does, but only while it's the "other" (not-currently-selected) chip -
                     ToolTipService.IsEnabled is bound to the opposite of that chip's own
                     IsChecked, since the currently-active mode needs no explanation of what
                     choosing it would do. -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <RadioButton Content="Fleet Carrier"
                                 GroupName="TrackingMode"
                                 Style="{StaticResource MaterialDesignChoiceChipPrimaryRadioButton}"
                                 IsChecked="{Binding IsShipMode, Mode=TwoWay, Converter={StaticResource InverseBooleanConverter}}"
                                 ToolTip="Track a Fleet Carrier's progress via a Captain's journal, with optional Auto Pilot automation."
                                 ToolTipService.IsEnabled="{Binding IsShipMode}"
                                 Margin="0,0,4,0" />
                    <RadioButton Content="Ship"
                                 GroupName="TrackingMode"
                                 Style="{StaticResource MaterialDesignChoiceChipPrimaryRadioButton}"
                                 IsChecked="{Binding IsShipMode, Mode=TwoWay}"
                                 ToolTip="Passively track your own ship along a manually-flown route - no automation, you plot and fly every jump yourself."
                                 ToolTipService.IsEnabled="{Binding IsShipMode, Converter={StaticResource InverseBooleanConverter}}" />
                </StackPanel>

                <!-- Silences Auto Pilot's spoken plot/refuel announcements (SpeechAnnouncer.Speak) -
                     does not affect the Preferences dialog's own Test button, which always plays. -->
                <Button Grid.Column="2"
                        Style="{StaticResource MaterialDesignIconButton}"
                        Command="{Binding SpeechAnnouncer.ToggleMuteCommand}"
                        ToolTip="Mute/unmute spoken announcements"
                        AutomationProperties.Name="Mute announcements"
                        Margin="0,0,4,0">
                    <materialDesign:PackIcon Kind="{Binding SpeechAnnouncer.Muted, Converter={StaticResource MuteIconConverter}}" />
                </Button>
            </Grid>
        </Border>

        <!-- Shown regardless of which tab is active, since losing the target window's focus
             mid-playback (Controls tab, §6.3) can happen while the user is looking at any of
             them. Solid fill (not just an outline) with white text, so it reads as a clear
             warning at a glance rather than something easy to miss. -->
        <Border Grid.Row="1"
                Visibility="{Binding ControlsViewModel.PlaybackErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"
                Background="{DynamicResource MaterialDesign.Brush.ValidationError}"
                Padding="10,6"
                Margin="8,8,8,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Grid.Column="0"
                                          Kind="AlertCircleOutline"
                                          Foreground="White"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ControlsViewModel.PlaybackErrorMessage}"
                           Foreground="White"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
                <Button Grid.Column="2"
                        Style="{StaticResource MaterialDesignIconButton}"
                        Foreground="White"
                        Padding="4"
                        Command="{Binding ControlsViewModel.DismissPlaybackErrorCommand}"
                        ToolTip="Dismiss"
                        AutomationProperties.Name="Dismiss playback error">
                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16" />
                </Button>
            </Grid>
        </Border>

        <TabControl Grid.Row="2" Margin="8" TabStripPlacement="Left"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabItem Header="Route">
                <views:RouteView DataContext="{Binding RouteViewModel}" />
            </TabItem>
            <TabItem Header="Roles"
                     Visibility="{Binding IsShipMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                <views:RolesView DataContext="{Binding RolesViewModel}" />
            </TabItem>
            <TabItem Header="Controls"
                     Visibility="{Binding IsShipMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                <views:ControlsView DataContext="{Binding ControlsViewModel}" />
            </TabItem>
            <TabItem Header="Track"
                     Visibility="{Binding IsShipMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <views:TrackView DataContext="{Binding TrackViewModel}" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
