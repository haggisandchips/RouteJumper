<Window x:Class="RouteJumper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:views="clr-namespace:RouteJumper.Views"
        xmlns:vm="clr-namespace:RouteJumper.ViewModels"
        mc:Ignorable="d"
        Title="Route Jumper" Height="600" Width="800">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <TabControl Margin="8">
        <TabItem Header="Route">
            <views:RouteView DataContext="{Binding RouteViewModel}" />
        </TabItem>
        <TabItem Header="Control">
            <views:ControlView DataContext="{Binding ControlViewModel}" />
        </TabItem>
    </TabControl>
</Window>
