<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RouteJumper</RootNamespace>
    <!-- The exe filename/output assembly identity - deliberately renamed alongside the AppData
         folder (AppSettingsStore/AppConfigStore) and the Velopack app ID (.github/workflows/
         release.yml, README's manual packaging steps): a clean break, not a migration, since
         there's currently only one installed copy and it'll be uninstalled/reinstalled rather
         than updated in place. Product/AssemblyTitle below feed the exe's own Win32 version
         resource (Explorer's file Properties, Task Manager, Velopack's Start Menu shortcut
         naming); the window's own Title (MainWindow.xaml) - what the taskbar button itself
         shows - already says "ED:FC Auto Pilot" independently of this. -->
    <AssemblyName>EDFCAutoPilot</AssemblyName>
    <Product>ED:FC Auto Pilot</Product>
    <AssemblyTitle>ED:FC Auto Pilot</AssemblyTitle>
    <Description>Elite Dangerous fleet carrier Auto Pilot</Description>
    <ProjectGuid>{8F1B2C3D-4A5E-4F6B-9C7D-1E2F3A4B5C6D}</ProjectGuid>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MaterialDesignColors" Version="5.3.2" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="System.Speech" Version="10.0.10" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\AppIcon.ico" />
  </ItemGroup>

  <!--
    Static Frame Shift Drive / Guardian FSD Booster stat tables the Galaxy Plotter tab needs to
    turn a ship's Loadout event into Spansh's own /api/generic/route request fields (Services\
    Spansh\ShipBuildDerivation) - vendored, trimmed copies of EDCD/coriolis-data's own module
    data (see FrameShiftDriveCatalog's own doc comment for the source URLs), not hand-typed.
    First embedded-resource precedent in this project.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Services\Spansh\Data\*.json" />
  </ItemGroup>

  <!--
    App.xaml is normally compiled as ApplicationDefinition, which makes the WPF SDK
    targets auto-generate a Main() entry point. Velopack needs to run before any
    Application/window is created, so App.xaml.cs supplies its own Main() instead -
    that requires App.xaml to be compiled as a plain Page (still gets InitializeComponent,
    just no generated Main).
  -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RouteJumper.Tests" />
  </ItemGroup>

</Project>
