<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RouteJumper</RootNamespace>
    <AssemblyName>RouteJumper</AssemblyName>
    <!-- Display identity only - AssemblyName above (the exe filename) stays "RouteJumper" so
         Velopack's self-update (keyed on the exe path) keeps working for already-installed
         copies. Product/AssemblyTitle feed the exe's own Win32 version resource, which is what
         Explorer's file Properties, Task Manager, and Velopack's own Start Menu shortcut naming
         read - the window's Title (MainWindow.xaml), which is what the taskbar button itself
         shows, is already "ED:FC Auto Pilot" independently of this. -->
    <Product>ED:FC Auto Pilot</Product>
    <AssemblyTitle>ED:FC Auto Pilot</AssemblyTitle>
    <Description>Elite Dangerous fleet carrier Auto Pilot</Description>
    <ProjectGuid>{8F1B2C3D-4A5E-4F6B-9C7D-1E2F3A4B5C6D}</ProjectGuid>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MaterialDesignColors" Version="5.3.2" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="System.Speech" Version="10.0.10" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\AppIcon.ico" />
  </ItemGroup>

  <!--
    App.xaml is normally compiled as ApplicationDefinition, which makes the WPF SDK
    targets auto-generate a Main() entry point. Velopack needs to run before any
    Application/window is created, so App.xaml.cs supplies its own Main() instead -
    that requires App.xaml to be compiled as a plain Page (still gets InitializeComponent,
    just no generated Main).
  -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RouteJumper.Tests" />
  </ItemGroup>

</Project>
